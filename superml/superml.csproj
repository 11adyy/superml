<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>superml</Title>
    <Authors>Noah Dylan Pelegrini</Authors>
    <Description>Library for working with CNN and classic NN</Description>
    <PackageProjectUrl>https://github.com/11adyy/superml</PackageProjectUrl>
    <TargetFrameworks>net6.0;net7.0</TargetFrameworks>
    <Version>1.0.1</Version>
    <RepositoryUrl>https://github.com/11adyy/superml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>CNN, FNN</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="https:\raw.githubusercontent.com\11adyy\superml\master\README.md" />
  </ItemGroup>

</Project>
