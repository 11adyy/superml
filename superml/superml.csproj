<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>superml</Title>
    <Authors>Noah Dylan Pelegrini</Authors>
    <Description>Library for working with RNN, R-CNN, CNN, GAN, and classic NN for classification, generate and analyze data</Description>
    <PackageProjectUrl>https://github.com/11adyy/superml</PackageProjectUrl>
    <TargetFrameworks>net6.0;net7.0</TargetFrameworks>
    <Version>1.0.3</Version>
    <RepositoryUrl>https://github.com/11adyy/superml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>RNN, GAN, CNN, R-CNN, FNN, Classification, Tensors</PackageTags>
    <PackageIcon>packageIcon.png</PackageIcon>
    <PackageVersion>2.4.0</PackageVersion>
    <PackageReleaseNotes>implemented GAN</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="https:\raw.githubusercontent.com\11adyy\superml\master\README.md" />
    <None Include="packageIcon.png" Pack="true" PackagePath="">
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0-preview.2.23128.3" />
  </ItemGroup>

</Project>
